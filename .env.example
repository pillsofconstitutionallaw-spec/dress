# Copia questo file in .env.local per lo sviluppo locale,
# e aggiungi le stesse variabili in Vercel > Settings > Environment Variables.

# Chiave GRATUITA (senza carta) da https://aistudio.google.com/apikey
# L'app funziona ANCHE SENZA questa chiave (modalità demo), così puoi presentarla subito.
GEMINI_API_KEY=

# Opzionale: modello Gemini.
GEMINI_MODEL=gemini-2.5-flash

# Opzionale: scelta del provider AI.
#   (vuoto) = auto  → Gemini se c'è la chiave, altrimenti demo
#   demo            → sempre risultati d'esempio
#   gemini          → forza Gemini
# In futuro qui potrai mettere "mistral", "openai", "custom", ecc.
AI_PROVIDER=

# --- Account utente (OPZIONALE) ---
# Servono solo per registrazione/login e salvataggio di palette, preferiti e outfit.
# Senza queste variabili l'app funziona lo stesso: i dati restano nel browser
# (localStorage) e le API /api/auth|profile|favorites|outfits rispondono NO_SUPABASE.
# Valori da https://supabase.com → progetto → Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chiave SEGRETA (solo lato server, mai nel browser).
SUPABASE_SERVICE_ROLE_KEY=

# Le stesse URL/anon key, esposte al browser per il login lato client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Indirizzo pubblico del sito: ci finiscono i link dentro le mail di conferma.
# In locale lascialo vuoto (usa automaticamente http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# --- Le parole (OPZIONALE) ---
# L'analisi dei colori e degli stili la fa Dress da sola, nel telefono: queste
# chiavi servono solo a rifinire i testi. Se mancano tutte, l'app funziona
# lo stesso, con le frasi già scritte.
#
# Vengono provate IN FILA, in quest'ordine: quando una finisce i crediti,
# risponde la successiva. Mettine almeno due.
#
# 1) Mistral — europeo, quindi i selfie non escono dall'UE. Tier gratuito.
#    Chiave su https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=pixtral-12b-2409

# 2) Groq — tier gratuito molto ampio e velocissimo. https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# 3) OpenRouter — una chiave sola per decine di modelli, alcuni gratuiti.
#    https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# 4) Un endpoint tuo, o qualsiasi altro compatibile con OpenAI.
# AI_API_URL=
# AI_API_KEY=
# AI_MODEL=

# Per forzarne uno solo: mistral | groq | openrouter | personale | gemini | demo
# AI_PROVIDER=
