/node_modules
/.next
/out
# Qualunque .env resta sul computer: .env.example è l'unico da pubblicare,
# perché elenca i nomi delle chiavi e non i loro valori.
.env*
!.env.example
.DS_Store
*.log

# Registra ogni comando approvato, credenziali comprese: resta sul computer.
.claude/settings.json
.claude/settings.local.json
.vercel

# Le copie che scrive scripts/sistema-genere.mjs prima di toccare il catalogo:
# servono a disfare, non a essere pubblicate.
genere-prima-*.json
qualita-prima-*.json
colore-prima-*.json

# I salvataggi delle persone iscritte: email, date di nascita, impronte
# di password. Questo repository è pubblico, quindi qui dentro non entrano
# mai. Una prova in scripts/prove.mjs controlla che questa riga resti.
salvataggi/
